# ============================================
# CalmTinnitus — Environment Variables
# ============================================
# Copy this file to .env.local and fill in values.

# --- Firebase Client (REQUIRED for web app) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (REQUIRED for server-side promo validation) ---
# Also supports legacy names: FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# --- PayPal Subscription (REQUIRED for payment flow) ---
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_PLAN_ID=

# --- Promo Codes ---
# Promo codes are stored in Firestore (collection: "promoCodes"), NOT in env vars.
# To create a promo code, add a document to Firestore with these fields:
#
#   code:            "FREEACCESS"          (string, stored UPPERCASE)
#   active:          true                  (boolean)
#   type:            "free"                (string: "free" or "discount")
#   expiresAt:       null                  (timestamp or null for no expiry)
#   maxRedemptions:  100                   (number or null for unlimited)
#   redemptions:     0                     (number — auto-incremented by API)
#   notes:           "Launch promo"        (string, optional)
#
# The API route /api/promo/validate handles validation server-side via Firebase Admin.
# Users enter promo codes on the Register → Payment step.

# --- Optional ---
# RESEND_API_KEY=         # For review email notifications

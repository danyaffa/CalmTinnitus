# ============================================
# CalmTinnitus — Environment Variables
# ============================================
# Copy this file to .env.local and fill in values.

# --- Firebase Client (REQUIRED for web app) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server-side: review stats + review email persistence) ---
# Read by utils/firebaseAdmin.ts. Use EITHER option A or option B.
#
# Option A (easiest): paste the entire service-account JSON ({ ... }) as one value
# FIREBASE_SERVICE_ACCOUNT_KEY=
#
# Option B: the three individual fields. FIREBASE_PRIVATE_KEY is ONLY the
# private_key value (-----BEGIN PRIVATE KEY----- ... -----END PRIVATE KEY-----),
# not the whole JSON.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- PayPal Subscription (REQUIRED for payment flow) ---
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_PLAN_ID=

# --- Promo Code (gives free access, bypasses PayPal) ---
NEXT_PUBLIC_PROMO_CODE=

# --- Review email notifications (optional) ---
# RESEND_API_KEY=           # Resend API key used to send review notifications
# REVIEW_RECEIVER_EMAIL=    # Inbox that receives new-review notifications
